{
    "compilerOptions": {
        "target": "ES6",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "types": ["@webgpu/types"],
        "lib": ["ES2020", "DOM", "WebWorker"],
        "moduleResolution": "Node",
        "strict": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0"
    },
    "include": ["src"]
}
